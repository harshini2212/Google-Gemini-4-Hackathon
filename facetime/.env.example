# Fill these in privately. All three LiveKit values must belong to one project.
# On a Shared plan with Chert rooms, leave all three empty (LIVEKIT_URL=): calls then run in Chert's LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A model API key with Realtime access and available API credits.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Optional. Her voice. Without these two she speaks with OpenAI's own voice.
# ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=

# Optional. Opens the research desk (LangChain Deep Agents): comparisons during the call, the packet after it.
# ANTHROPIC_API_KEY=

# Optional. Chert's API, for the text after a call (after-call.mjs) and an outbound call (call.mjs).
# CHERT_API_KEY=
# CHERT_PROJECT_ID=

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video

# Optional. The phone that gets the "how was the tour?" text after a call when the caller gave Ellie no number
# (Chert does not say who called). It must be a phone that has joined your Chert project.
# OPEN_HOUSE_FEEDBACK_TO=
